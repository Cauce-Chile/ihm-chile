# Clave de API de Resend para el envío de correos transaccionales
RESEND_API_KEY=

# Correo del administrador que recibirá las notificaciones de nuevas cotizaciones
ADMIN_EMAIL=

# SID de cuenta Twilio (se obtiene en la consola de Twilio)
TWILIO_ACCOUNT_SID=

# Token de autenticación de Twilio
TWILIO_AUTH_TOKEN=

# Número de WhatsApp remitente de Twilio (formato: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=

# Content SID de la plantilla de mensaje aprobada para admin
TWILIO_CONTENT_SID_ADMIN=

# Número de WhatsApp del administrador que recibirá las notificaciones (formato: whatsapp:+56912345678)
ADMIN_WHATSAPP=
